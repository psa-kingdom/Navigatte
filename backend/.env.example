# MongoDB Connection Details
MONGO_URL=mongodb://localhost:27017
DB_NAME=navigatte_dev

# Environment (development / production)
ENVIRONMENT=development

# CORS Settings
# Comma-separated list of explicit allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://navigatte.com,https://www.navigatte.com,https://navigatte-website.vercel.app

# Optional regex pattern for preview deployment origins (e.g. Vercel preview environments)
# Defaults to scoped Navigatte preview pattern: ^https:\/\/(navigatte-website|navigatte)(-[a-z0-9-]+)?-psumanassociates-9980s-projects\.vercel\.app$
# CORS_ORIGIN_REGEX=^https:\/\/(navigatte-website|navigatte)(-[a-z0-9-]+)?-psumanassociates-9980s-projects\.vercel\.app$

# Cookie Security (Defaults: SameSite=None + Secure=True in production; SameSite=Lax + Secure=False in dev)
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# Authentication Secrets
JWT_SECRET=supersecretlocaldevelopmentsignedkey321!

# Initial Seed Admin Credentials (optional for local dev)
ADMIN_EMAIL=admin@navigatte.com
ADMIN_PASSWORD=Navigatte@Admin2026

# Cal.com Scheduling Integration
CAL_ENABLED=false
CAL_API_KEY=
CAL_WEBHOOK_SECRET=
CAL_EVENT_TYPE_ID=
CAL_WEBHOOK_SUBSCRIBER_URL=https://navigatte-website-production.up.railway.app/api/webhooks/cal

# Resend Communications & Email Management System (EMS)
# Setting RESEND_API_KEY activates Resend delivery automatically.
# RESEND_ENABLED can be explicitly set to 'false' to disable outbound dispatch even if a key is present.
RESEND_API_KEY=
RESEND_ENABLED=true
RESEND_FROM_EMAIL=Navigatte <updates@updates.navigatte.com>
RESEND_WEBHOOK_SECRET=
COMMUNICATIONS_ENVIRONMENT=development
ALLOWED_TEST_RECIPIENTS=
